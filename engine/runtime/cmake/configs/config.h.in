#pragma once

#include <engine/config.h>

namespace engine::runtime::config
{
    namespace glfw
    {
        constexpr bool enable = @RATS_ENGINE_RUNTIME_GLFW_ENABLE_VALUE@;
    }

    namespace vulkan
    {
        constexpr bool enable = @RATS_ENGINE_RUNTIME_VULKAN_ENABLE_VALUE@;
        constexpr bool validation_layers = engine::runtime::config::vulkan::enable
            && engine::config::debug
            && @RATS_ENGINE_RUNTIME_VULKAN_ENABLE_VALIDATION_LAYERS_VALUE@;
    }
}